---
import Panel from './Panel.astro';
import Icon from './Icon.astro';
import styles from './Alert.module.css';

interface Props {
  variant: 'info' | 'warning' | 'error' | 'success';
  title?: string;
  class?: string;
}

const { variant, title, class: className } = Astro.props;

const panelClass = [styles.alert, styles[variant], className].filter(Boolean).join(' ');
---

<Panel class={panelClass}>
  <div class={styles.alertContent}>
    <div class={styles.alertIcon}>
      <Icon name="x-circle" />
    </div>
    <div class={styles.alertBody}>
      {title && <div class={styles.alertTitle}>{title}</div>}
      <div>
        <slot />
      </div>
    </div>
  </div>
</Panel>
