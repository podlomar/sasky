[Unit]
Description=Sasky Chess Application
Documentation=https://github.com/podlomar/sasky
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/sasky.podlomar.me
ExecStart=/usr/bin/node dist/server/entry.mjs
Restart=on-failure
RestartSec=10
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=5
SyslogIdentifier=sasky

# Environment variables
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=9000
Environment=SASKY_DATA_DIR=/var/www/sasky.podlomar.me/data

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/sasky.podlomar.me/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
